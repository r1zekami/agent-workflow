# Copy to .env in the runtime folder (WSL ~/services/litellm/) and fill in.
# Never commit .env. Generate the first three with the command in README.md.

# Proxy admin key; also the admin UI password. Must start with "sk-".
LITELLM_MASTER_KEY=
# Encrypts credentials stored in the database. Never change it after first start.
LITELLM_SALT_KEY=
# Local Postgres password, hex only (it is part of a URL).
POSTGRES_PASSWORD=

# Provider keys, from each provider's dashboard.
DEEPSEEK_KEY=
