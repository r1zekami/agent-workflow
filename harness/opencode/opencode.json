{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "{{HOME}}/.claude/rules/*.md"
  ],
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "share": "disabled",
  "permissions": [
    {"action": "*", "resource": "*", "effect": "allow"},
    {"action": "read", "resource": "*", "effect": "allow"},
    {"action": "read", "resource": "*.env", "effect": "deny"},
    {"action": "read", "resource": "*.env.*", "effect": "deny"},
    {"action": "read", "resource": "*.env.example", "effect": "allow"},
    {"action": "read", "resource": "~/.ssh/*", "effect": "deny"},
    {"action": "read", "resource": "~/.aws/*", "effect": "deny"},
    {"action": "read", "resource": "~/.git-credentials", "effect": "deny"},
    {"action": "read", "resource": "~/.netrc", "effect": "deny"},
    {"action": "read", "resource": "~/.npmrc", "effect": "deny"},
    {"action": "read", "resource": "~/.pypirc", "effect": "deny"},
    {"action": "read", "resource": "~/.docker/config.json", "effect": "deny"},
    {"action": "read", "resource": "~/.kube/config", "effect": "deny"},
    {"action": "read", "resource": "~/.config/opencode/opencode.json", "effect": "deny"},
    {"action": "edit", "resource": "*", "effect": "allow"},
    {"action": "edit", "resource": "*.env", "effect": "deny"},
    {"action": "edit", "resource": "*.env.*", "effect": "deny"},
    {"action": "edit", "resource": "*.env.example", "effect": "allow"},
    {"action": "edit", "resource": "~/.ssh/*", "effect": "deny"},
    {"action": "edit", "resource": "~/.aws/*", "effect": "deny"},
    {"action": "edit", "resource": "~/.git-credentials", "effect": "deny"},
    {"action": "edit", "resource": "~/.netrc", "effect": "deny"},
    {"action": "edit", "resource": "~/.npmrc", "effect": "deny"},
    {"action": "edit", "resource": "~/.pypirc", "effect": "deny"},
    {"action": "edit", "resource": "~/.docker/config.json", "effect": "deny"},
    {"action": "edit", "resource": "~/.kube/config", "effect": "deny"},
    {"action": "edit", "resource": "~/.config/opencode/opencode.json", "effect": "deny"},
    {"action": "external_directory", "resource": "*", "effect": "allow"},
    {"action": "shell", "resource": "*", "effect": "allow"},
    {"action": "shell", "resource": "*.ssh/*", "effect": "ask"},
    {"action": "shell", "resource": "*.ssh\\*", "effect": "ask"},
    {"action": "shell", "resource": "*.aws/*", "effect": "ask"},
    {"action": "shell", "resource": "*.aws\\*", "effect": "ask"},
    {"action": "shell", "resource": "*.git-credentials*", "effect": "ask"},
    {"action": "shell", "resource": "*.netrc*", "effect": "ask"},
    {"action": "shell", "resource": "*.npmrc*", "effect": "ask"},
    {"action": "shell", "resource": "*.pypirc*", "effect": "ask"},
    {"action": "shell", "resource": "*.docker/config.json*", "effect": "ask"},
    {"action": "shell", "resource": "*.docker\\config.json*", "effect": "ask"},
    {"action": "shell", "resource": "*.kube/config*", "effect": "ask"},
    {"action": "shell", "resource": "*.kube\\config*", "effect": "ask"},
    {"action": "shell", "resource": "*.config/opencode/opencode.json*", "effect": "ask"},
    {"action": "shell", "resource": "*.config\\opencode\\opencode.json*", "effect": "ask"},
    {"action": "shell", "resource": "env", "effect": "deny"},
    {"action": "shell", "resource": "env *", "effect": "deny"},
    {"action": "shell", "resource": "printenv*", "effect": "deny"},
    {"action": "shell", "resource": "*printenv*", "effect": "deny"},
    {"action": "shell", "resource": "set", "effect": "deny"},
    {"action": "shell", "resource": "export", "effect": "deny"},
    {"action": "shell", "resource": "Get-ChildItem env:*", "effect": "deny"},
    {"action": "shell", "resource": "gci env:*", "effect": "deny"},
    {"action": "shell", "resource": "dir env:*", "effect": "deny"},
    {"action": "shell", "resource": "ls env:*", "effect": "deny"},
    {"action": "shell", "resource": "Get-Item env:*", "effect": "deny"},
    {"action": "shell", "resource": "*$env:*", "effect": "deny"},
    {"action": "shell", "resource": "*[Environment]::GetEnvironmentVariable*", "effect": "deny"},
    {"action": "shell", "resource": "*/proc/*/environ*", "effect": "deny"},
    {"action": "shell", "resource": "*echo $*KEY*", "effect": "deny"},
    {"action": "shell", "resource": "*echo $*TOKEN*", "effect": "deny"},
    {"action": "shell", "resource": "*echo $*SECRET*", "effect": "deny"},
    {"action": "shell", "resource": "*echo $*PASSWORD*", "effect": "deny"},
    {"action": "shell", "resource": "*cat *.env", "effect": "deny"},
    {"action": "shell", "resource": "*cat *.env.*", "effect": "deny"},
    {"action": "shell", "resource": "*type *.env", "effect": "deny"},
    {"action": "shell", "resource": "*type *.env.*", "effect": "deny"},
    {"action": "shell", "resource": "*Get-Content *.env", "effect": "deny"},
    {"action": "shell", "resource": "*Get-Content *.env.*", "effect": "deny"},
    {"action": "shell", "resource": "*head *.env", "effect": "deny"},
    {"action": "shell", "resource": "*tail *.env", "effect": "deny"},
    {"action": "shell", "resource": "*less *.env", "effect": "deny"},
    {"action": "shell", "resource": "*more *.env", "effect": "deny"},
    {"action": "shell", "resource": "*grep * .env", "effect": "deny"},
    {"action": "shell", "resource": "*rg * .env", "effect": "deny"},
    {"action": "shell", "resource": "*sed * .env", "effect": "deny"},
    {"action": "shell", "resource": "*awk * .env", "effect": "deny"},
    {"action": "shell", "resource": "*bat *.env", "effect": "deny"},
    {"action": "shell", "resource": "cat *.env.example", "effect": "allow"},
    {"action": "shell", "resource": "type *.env.example", "effect": "allow"},
    {"action": "shell", "resource": "head *.env.example", "effect": "allow"},
    {"action": "shell", "resource": "tail *.env.example", "effect": "allow"},
    {"action": "shell", "resource": "Get-Content *.env.example", "effect": "allow"},
    {"action": "shell", "resource": "*git push*", "effect": "ask"},
    {"action": "shell", "resource": "*bd sync*", "effect": "ask"},
    {"action": "shell", "resource": "*bd dolt push*", "effect": "ask"}
  ]
}
