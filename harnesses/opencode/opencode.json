{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (local)",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "{env:UNIVERSAL_LOCAL_LITELLM_KEY}"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek Flash",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        }
      }
    }
  },
  "model": "litellm/deepseek-flash",
  "small_model": "litellm/deepseek-flash",
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "external_directory": {
      "*": "allow"
    },
    "bash": {
      "*": "allow",
      "env": "deny",
      "env *": "deny",
      "printenv*": "deny",
      "*printenv*": "deny",
      "set": "deny",
      "export": "deny",
      "Get-ChildItem env:*": "deny",
      "gci env:*": "deny",
      "dir env:*": "deny",
      "ls env:*": "deny",
      "Get-Item env:*": "deny",
      "*$env:*": "deny",
      "*[Environment]::GetEnvironmentVariable*": "deny",
      "*/proc/*/environ*": "deny",
      "*echo $*KEY*": "deny",
      "*echo $*TOKEN*": "deny",
      "*echo $*SECRET*": "deny",
      "*echo $*PASSWORD*": "deny",
      "*cat *.env": "deny",
      "*cat *.env.*": "deny",
      "*type *.env": "deny",
      "*type *.env.*": "deny",
      "*Get-Content *.env": "deny",
      "*Get-Content *.env.*": "deny",
      "*head *.env": "deny",
      "*tail *.env": "deny",
      "*less *.env": "deny",
      "*more *.env": "deny",
      "*grep * .env": "deny",
      "*rg * .env": "deny",
      "*sed * .env": "deny",
      "*awk * .env": "deny",
      "*bat *.env": "deny",
      "cat *.env.example": "allow",
      "type *.env.example": "allow",
      "head *.env.example": "allow",
      "tail *.env.example": "allow",
      "Get-Content *.env.example": "allow",
      "*git push*": "ask",
      "*bd sync*": "ask",
      "*bd dolt push*": "ask"
    }
  }
}
